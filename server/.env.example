# This file is an example. Copy it to .env and fill in your actual values.

# For local development with SQLite, use the line below:
DATABASE_URL="sqlite:///./sql_app.db"

# For PostgreSQL, use the format below.
# Make sure to replace user, password, host, port, and database_name with your actual database credentials.
# DATABASE_URL="postgresql://user:password@host:port/database_name"

# CoinGecko API key (optional for public endpoints, but good to have)
# COINGECKO_API_KEY=your_api_key_here
